---
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  audience: string;
  stub?: boolean;
}
const { title, audience, stub = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { href: `${base}/`, label: 'Researcher' },
  { href: `${base}/supervisor/`, label: 'Supervisor' },
  { href: `${base}/public/`, label: 'Public' },
];
const here = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title} · Research Portal</title>
  </head>
  <body>
    <header class="site-header">
      <span class="brand">Research Portal</span>
      <nav class="site-nav" aria-label="Views">
        {nav.map((n) => <a href={n.href} aria-current={here === n.href ? 'page' : undefined}>{n.label}</a>)}
      </nav>
    </header>
    <main>
      <div class="page-head">
        <h1>{title}</h1>
        <p class="muted">Audience: {audience}</p>
        <slot name="head" />
      </div>
      <slot />
      {stub && <p class="muted"><em>Stub page. Real content arrives in a later phase.</em></p>}
    </main>
  </body>
</html>
