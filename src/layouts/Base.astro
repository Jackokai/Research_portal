---
import '../styles/tokens.css';
import '../styles/global.css';
import LensSwitcher from '../components/LensSwitcher.astro';
import { PRIVATE_LENSES, type Lens } from '../lib/routes';

interface Props {
  title: string;
  audience: string;
  lens: Lens;
  stub?: boolean;
}
const { title, audience, lens, stub = false } = Astro.props;
const isPrivate = PRIVATE_LENSES.includes(lens);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {isPrivate && <meta name="robots" content="noindex" />}
    <title>{title} · Research Portal</title>
  </head>
  <body>
    <header class="site-header">
      <span class="brand">Research Portal</span>
      {isPrivate && <LensSwitcher current={lens} />}
    </header>
    <main>
      <div class="page-head">
        <h1>{title}</h1>
        <p class="muted">Audience: {audience}</p>
        <slot name="head" />
      </div>
      <slot />
      {stub && <p class="muted"><em>Stub page. Real content arrives in a later phase.</em></p>}
    </main>
  </body>
</html>
