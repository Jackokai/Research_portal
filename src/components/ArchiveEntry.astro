---
import { render, type CollectionEntry } from 'astro:content';
import EntryMeta from './EntryMeta.astro';

interface Props {
  entry: CollectionEntry<'archive'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, status, completedOn, summary, link, audience, sample } = entry.data;
---
<article class="card">
  <div class="card-head">
    <h3 class="card-title">{title}</h3>
    <EntryMeta audience={audience} sample={sample} status={status} filePath={entry.filePath} />
  </div>
  {completedOn && <p class="muted small card-date">Completed {completedOn}</p>}
  <p>{summary}</p>
  <div class="prose"><Content /></div>
  {link && <p class="small link-line"><a href={link} target="_blank" rel="noopener">Open materials</a></p>}
</article>
