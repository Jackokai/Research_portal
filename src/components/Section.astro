---
interface Props {
  id: string;
  title: string;
  count?: number;
  empty?: boolean;
}
const { id, title, count, empty = false } = Astro.props;
---
<section id={id} class="section" aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>{title}{count !== undefined && <span class="section-count"> · {count}</span>}</h2>
  {empty ? <p class="muted">Nothing here yet.</p> : <slot />}
</section>
