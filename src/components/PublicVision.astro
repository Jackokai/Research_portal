---
// Only the plain-language summary is ever shown here, never the body.
import type { CollectionEntry } from 'astro:content';
import Section from './Section.astro';

interface Props {
  entries: CollectionEntry<'vision'>[]; // already filtered with published()
}
const { entries } = Astro.props;
---
{entries.length > 0 && (
  <Section id="about" title="What this research is about">
    {entries.map((e) => <p class="lead">{e.data.summaryPlain}</p>)}
  </Section>
)}
