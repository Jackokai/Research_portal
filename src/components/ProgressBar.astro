---
// Progress is a 0-1 value from src/lib/okr.ts. The percentage is also shown as text next to it.
import { percent } from '../lib/format';

interface Props {
  value: number;
  label: string;
}
const { value, label } = Astro.props;
const pct = Math.round(Math.min(1, Math.max(0, value)) * 100);
---
<div class="progress-row">
  <div class="bar" role="progressbar" aria-label={label} aria-valuemin="0" aria-valuemax="100" aria-valuenow={pct}>
    <span style={`width: ${pct}%`}></span>
  </div>
  <span class="pct">{percent(value)}</span>
</div>
