---
import { getCollection, getEntry } from 'astro:content';
import Archive from '../components/Archive.astro';
import Feedback from '../components/Feedback.astro';
import Goals from '../components/Goals.astro';
import Requirements from '../components/Requirements.astro';
import Vision from '../components/Vision.astro';
import Base from '../layouts/Base.astro';
import { openFirstNewest, orderGoals, splitArchive } from '../lib/order';
import { resolveSettings } from '../lib/settings';

const [vision, goals, archive, feedback, requirements] = await Promise.all([
  getCollection('vision'),
  getCollection('goals'),
  getCollection('archive'),
  getCollection('feedback'),
  getCollection('requirements'),
]);
const { ongoing, completed } = splitArchive(archive);
const showFeedback = resolveSettings((await getEntry('settings', 'settings'))?.data).features.feedback;
const sections = [
  ['vision', 'Vision'],
  ['goals', 'Goals'],
  ['archive', 'Archive'],
  ...(showFeedback ? [['feedback', 'Feedback']] : []),
  ['requirements', 'Requirements'],
];
---
<Base title="Researcher workspace" audience="Researcher" stub={false}>
  <nav slot="head" aria-label="Sections">
    <ul class="toc">
      {sections.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
    </ul>
  </nav>
  <Vision entries={vision} />
  <Goals quarters={orderGoals(goals)} />
  <Archive ongoing={ongoing} completed={completed} />
  {showFeedback && <Feedback entries={openFirstNewest(feedback, 'open')} />}
  <Requirements entries={openFirstNewest(requirements, 'open')} />
</Base>
